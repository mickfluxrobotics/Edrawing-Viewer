{
  "name": "eDrawings Viewer",
  "short_name": "eDrawings",
  "description": "View eDrawings, STEP, STL and 3MF models and DXF or DWG drawings. Hide parts and take measurements. Files stay on this device.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#F4F6F7",
  "theme_color": "#F4F6F7",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/vnd.edrawings.easm": [
          ".easm"
        ],
        "application/vnd.edrawings.eprt": [
          ".eprt"
        ],
        "model/step": [
          ".step",
          ".stp"
        ],
        "model/stl": [
          ".stl"
        ],
        "model/3mf": [
          ".3mf"
        ],
        "image/vnd.dxf": [
          ".dxf"
        ],
        "image/vnd.dwg": [
          ".dwg"
        ]
      },
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}